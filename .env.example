# Órbita — Environment Variables
# Copy this file to .env.local and fill in the values.

# Optional: Override the canonical site URL.
# Set this on Vercel preview branches so Open Graph and canonical links use
# the correct preview URL instead of the hardcoded production URL.
# NEXT_PUBLIC_SITE_URL=https://your-preview.vercel.app

# Optional: Upstash Redis for distributed rate limiting
# Create a Redis database at https://console.upstash.com
# UPSTASH_REDIS_REST_URL=https://example.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here

# Required in production: authenticates Vercel Cron requests to /api/cron/ingest.
# Generate a long random value and configure the same value in Vercel.
# CRON_SECRET=replace_with_a_long_random_secret

# Recommended: a separate HMAC key for URLs emitted by the image proxy. When
# omitted, CRON_SECRET is used as a domain-separated fallback.
# IMAGE_PROXY_SECRET=replace_with_another_long_random_secret
